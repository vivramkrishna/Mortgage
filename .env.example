# Copy to .env and adjust if needed. All values have sane defaults baked in.

# FastAPI backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Lloyds demo web application (frontend)
FRONTEND_HOST=localhost
FRONTEND_PORT=3000
FRONTEND_BASE_URL=http://localhost:3000

# Bank core service — owns the customer records, the underwriting engine and
# the internal Command Centre dashboard. The backend calls it over HTTP.
BANK_HOST=localhost
BANK_PORT=4000
BANK_BASE_URL=http://localhost:4000

# Public URL of the backend once tunnelled through ngrok.
# scripts/start.py sets this automatically once the tunnel is up — you only
# need to set it manually if you start ngrok yourself, separately.
PUBLIC_BASE_URL=http://localhost:8000

# SMTP settings used to send OTP verification codes for the mortgage +
# transactions authentication flow. Any standard SMTP provider works, e.g.:
#   - Gmail:    smtp.gmail.com:587  (requires a Google "App Password", not
#               your normal password — https://myaccount.google.com/apppasswords)
#   - Outlook:  smtp.office365.com:587
#   - SendGrid: smtp.sendgrid.net:587  (SMTP_USERNAME=apikey, SMTP_PASSWORD=<your API key>)
#   - Mailtrap / Ethereal / Mailgun sandbox — good free options for local testing
#     without sending real email (e.g. https://mailtrap.io sandbox inbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Local-dev-only: exposes GET /api/_debug/otp so scripts/test_mcp.py can read
# the pending OTP without a real inbox. NEVER set this to true in a real
# deployment.
DEBUG_EXPOSE_OTP=false
